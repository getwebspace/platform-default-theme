{% extends 'main.twig' %}

{% block title %}Password recovery | {{ parent() }}{% endblock %}

{% block page %}
    {% include 'common/breadcrumbs.twig' with {
        'title': 'Password recovery'
    } %}

    <!-- Start Account Area -->
    <div class="account-login section">
        <div class="container">
            <div class="row">
                <div class="col-lg-6 offset-lg-3 col-md-10 offset-md-1 col-12">

                    {# the link was mailed out, the same message shows whether or not the account exists #}
                    {% if sent %}
                        <div class="card login-form">
                            <div class="card-body">
                                <div class="title">
                                    <h3>Check your inbox</h3>
                                    <p>
                                        If an account with that address exists, we have sent it a link
                                        to choose a new password. The link is valid for one hour.
                                    </p>
                                </div>
                                <p class="outer-link"><a href="/user/login">Back to login</a></p>
                            </div>
                        </div>

                    {# the link is worn out: expired, already used, or tampered with #}
                    {% elseif stage == 'expired' %}
                        <div class="card login-form">
                            <div class="card-body">
                                <div class="title">
                                    <h3>This link no longer works</h3>
                                    <p>
                                        Recovery links expire after an hour and stop working once the
                                        password has been changed. Please request a new one.
                                    </p>
                                </div>
                                <p class="outer-link"><a href="/user/recovery">Request a new link</a></p>
                            </div>
                        </div>

                    {# the link checked out, pick the new password #}
                    {% elseif stage == 'reset' %}
                        <form class="card login-form" method="post" data-grecaptcha>
                            <input type="hidden" name="token" value="{{ token }}" />

                            <div class="card-body">
                                <div class="title">
                                    <h3>Choose a new password</h3>
                                    <p>Once it is saved you will be signed out everywhere and can log in again.</p>
                                </div>

                                {% include 'mixin/form.twig' with {
                                    'label': 'New password',
                                    'type': 'password',
                                    'name': 'password',
                                    'args': {
                                        'required': true,
                                        'autocomplete': 'new-password'
                                    }
                                } %}

                                {% include 'mixin/form.twig' with {
                                    'label': 'Confirm new password',
                                    'type': 'password',
                                    'name': 'password_again',
                                    'args': {
                                        'required': true,
                                        'autocomplete': 'new-password'
                                    }
                                } %}

                                <div class="button">
                                    <button class="btn" type="submit">Save password</button>
                                </div>
                            </div>
                        </form>

                    {# first step, ask who is asking #}
                    {% else %}
                        <form class="card login-form" method="post" data-grecaptcha>
                            <div class="card-body">
                                <div class="title">
                                    <h3>Forgot your password?</h3>
                                    <p>Enter the e-mail, username or phone of your account and we will send you a recovery link.</p>
                                </div>

                                {% include 'mixin/form.twig' with {
                                    'label': 'E-Mail, username or phone',
                                    'type': 'text',
                                    'name': 'identifier',
                                    'args': {
                                        'required': true,
                                        'autofocus': true
                                    }
                                } %}

                                <div class="button">
                                    <button class="btn" type="submit">Send recovery link</button>
                                </div>

                                <p class="outer-link">Remembered it? <a href="/user/login">Login here</a></p>
                            </div>
                        </form>
                    {% endif %}

                </div>
            </div>
        </div>
    </div>
    <!-- End Account Area -->

    {% include 'mixin/recaptcha.twig' %}
{% endblock %}
