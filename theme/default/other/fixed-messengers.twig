<script>
    document.addEventListener('DOMContentLoaded', () => {
        const base_bottom = 10
        const $container = $('.fixed-messengers')

        $container.find('button').on('click', ({target}) => {
            const h = $('.fixed-messengers__button').height();
            const h_svg = $('.fixed-messengers__button svg').height();
            const b_diff = h + h_svg;

            const $button = $(target);

            $button.hide(200)

            $('.fixed-messengers__telephone').animate({bottom: (base_bottom + b_diff * 2) + "px", opacity: 1}, 400);
            $('.fixed-messengers__telegram').animate({bottom: (base_bottom + b_diff) + "px", opacity: 1}, 400);
            $('.fixed-messengers__whatsapp').animate({bottom: base_bottom + "px", opacity: 1}, 400);

            setTimeout(() => {
                $('.fixed-messengers__button').animate({bottom: base_bottom + "px", opacity: 0}, 400);
                $button.animate({opacity: 1}, 200);
                $button.show(200);
            }, 15_000);
        });

        $container.find('a.fixed-messengers__telephone').on('click', (e) => {
            e.preventDefault()

            Swal.fire({
                title: `ОБРАТНЫЙ ЗВОНОК`,
                html:
                    `<input type="text" id="name" value="" name="name" class="swal2-input" placeholder="Ваше имя">` +
                    `<input type="tel" id="phone" value="" name="phone" class="swal2-input" placeholder="Ваш телефон">` +
                    `<div class="mt-3 small">Нажимая на кнопку «Перезвоните мне» вы даете согласие на обработку персональных данных в соответствии с пользовательским соглашением.</div>`,
                confirmButtonText: 'Перезвоните мне',
                showCloseButton: true,
                preConfirm: () => {
                    const name = Swal.getPopup().querySelector('[name="name"]').value;
                    const phone = Swal.getPopup().querySelector('[name="phone"]').value;

                    if (!name) {
                        Swal.showValidationMessage(`Введите имя!`);
                    }
                    if (!phone) {
                        Swal.showValidationMessage(`Введите телефон!`);
                    }
                    return {name, phone};
                }
            }).then((result) => {
                $.post("/form/request-call", {
                    name: result.value.name,
                    phone: result.value.phone,
                }, () => {
                    Swal.fire('Готово!', 'Ваш запрос успешно отправлен!', 'success');
                })
            })
        })
    });
</script>

<style>
    .fixed-messengers * {
        line-height: 54px!important;
    }

    .fixed-messengers__button {
        position: fixed;
        display: block;
        z-index: 98;
        right: 10px;
        bottom: 10px;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        width: 60px;
        height: 60px;
        color: #fff;
        text-align: center;
        font-size: 36px;
        line-height: 60px;
        opacity:0
    }

    .fixed-messengers__button:before, .fixed-messengers__button:after {
        content: " ";
        display: block;
        position: absolute;
        left: -10px;
        right: -10px;
        top: -10px;
        bottom: -10px;
        border-radius: 50%;
        animation: fixed-messengers__button-animate 5s linear infinite;
        opacity: 0;
        backface-visibility:hidden
    }

    .fixed-messengers__button:after {
        animation-delay: 0.8s
    }

    .fixed-messengers__button svg {
        fill: #fff;
        width: 30px;
        height:30px
    }

    .fixed-messengers__telephone {
        background-color:#274d49
    }

    .fixed-messengers__telephone:before, .fixed-messengers__telephone:after {
        border: 2px solid #274d49
    }

    .fixed-messengers__telegram {
        background-color: #1a93d4;
        padding-top: 2px;
        padding-right:2px
    }

    .fixed-messengers__telegram:before, .fixed-messengers__telegram:after {
        border: 2px solid #1a93d4
    }

    .fixed-messengers__telegram:after {
        animation-delay:1.4s
    }

    .fixed-messengers__whatsapp {
        background-color:#25d366
    }

    .fixed-messengers__whatsapp:before, .fixed-messengers__whatsapp:after {
        border: 2px solid #25d366
    }

    .fixed-messengers__whatsapp:after {
        animation-delay:1.5s
    }

    .fixed-messengers__conversation {
        bottom: 10px;
        background-color: #2a9185;
        transition: none;
        border: none;
        padding-top: 2px;
        z-index: 100;
        opacity:1
    }

    .fixed-messengers__conversation:before, .fixed-messengers__conversation:after {
        border: 2px solid #2a9185
    }

    .fixed-messengers__conversation:after {
        animation-delay:1.5s
    }

    .fixed-messengers button svg {
        position: absolute;
        left: 15px;
        top: 17px
    }

    @media screen and (max-width: 767px) {
        .fixed-messengers__button {
            right: 0;
            width: 40px;
            height: 40px;
            font-size: 26px;
            line-height:40px
        }

        .fixed-messengers__button:before, .fixed-messengers__button:after {
            border-width: 1px
        }

        .fixed-messengers__button svg {
            width: 20px;
            height:20px
        }

        .fixed-messengers__conversation {
            bottom:70px
        }
    }

    @keyframes fixed-messengers__button-animate {
        0% {
            transform: scale(0.5);
            opacity:0
        }

        50% {
            opacity:1
        }

        100% {
            transform: scale(1.1);
            opacity:0
        }
    }
</style>
